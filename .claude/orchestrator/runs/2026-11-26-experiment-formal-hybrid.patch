+/**
+ * Hybrid districts: a core pocket the fringe growth never reached would be dropped as floating
+ * (removeFloatingStreets). Each such street component of the district is joined to the anchored
+ * network (one with an avenue) by the shortest clear, allowed straight local street between two
+ * of their nodes, within FLOAT_LINK_REACH. Deterministic: ties break by node id.
+ */
+const FLOAT_LINK_REACH = 420;
+export function linkFloatingStreets(ctx: DistrictContext): number {
+  const { graph } = ctx;
+  const isStreetE = (e: GraphEdge) => e.cls !== 'frame';
+  let linked = 0;
+  for (let round = 0; round < 12; round++) {
+    const parent = new Map<number, number>();
+    const find = (x: number): number => {
+      let r = x;
+      while (parent.get(r) !== r) r = parent.get(r) as number;
+      return r;
+    };
+    const streets = graph.edges().filter(isStreetE);
+    for (const e of streets) for (const n of [e.a, e.b]) if (!parent.has(n)) parent.set(n, n);
+    for (const e of streets) {
+      const ra = find(e.a);
+      const rb = find(e.b);
+      if (ra !== rb) parent.set(Math.max(ra, rb), Math.min(ra, rb));
+    }
+    const anchored = new Set<number>();
+    for (const e of streets) if (e.fixed) anchored.add(find(e.a));
+    const nodesOf = new Map<number, number[]>();
+    for (const [n] of parent) {
+      const r = find(n);
+      const l = nodesOf.get(r);
+      if (l) l.push(n);
+      else nodesOf.set(r, [n]);
+    }
+    const floating = [...nodesOf.keys()].filter((r) => !anchored.has(r)).sort((a, b) => a - b);
+    const target = [...nodesOf.entries()].filter(([r]) => anchored.has(r)).flatMap(([, l]) => l).sort((a, b) => a - b);
+    let progress = false;
+    for (const r of floating) {
+      const cand: { d: number; a: number; b: number }[] = [];
+      for (const a of nodesOf.get(r) as number[]) {
+        const pa = graph.node(a);
+        for (const b of target) {
+          const pb = graph.node(b);
+          const d = Math.hypot(pa.x - pb.x, pa.y - pb.y);
+          if (d <= FLOAT_LINK_REACH && d >= 12) cand.push({ d, a, b });
+        }
+      }
+      cand.sort((x, y) => x.d - y.d || x.a - y.a || x.b - y.b);
+      for (const c of cand.slice(0, 40)) {
+        const pa = graph.node(c.a);
+        const pb = graph.node(c.b);
+        if (firstHit(graph, pa, pb, (e) => isStreetE(e) && e.a !== c.a && e.b !== c.a && e.a !== c.b && e.b !== c.b)) continue;
+        let ok = true;
+        for (let t = 0.1; t < 0.95 && ok; t += 0.1) ok = ctx.allowed('local', { x: pa.x + (pb.x - pa.x) * t, y: pa.y + (pb.y - pa.y) * t });
+        if (!ok) continue;
+        graph.addSegment({ x: pa.x, y: pa.y }, { x: pb.x, y: pb.y }, ctx.propsFor('local'));
+        linked++;
+        progress = true;
+        break;
+      }
+      if (progress) break;
+    }
+    if (!progress) break;
+  }
+  return linked;
+}
